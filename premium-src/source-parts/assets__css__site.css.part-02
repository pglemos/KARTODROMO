(--green),transparent);opacity:.7;width:38vw;animation:speedline 5.5s linear infinite;transform:skewX(-25deg)}.speed-lines i:nth-child(1){top:22%;left:0;animation-delay:-1.2s}.speed-lines i:nth-child(2){top:46%;left:42%;animation-delay:-3.4s}.speed-lines i:nth-child(3){top:72%;left:12%;animation-delay:-4.5s}@keyframes speedline{0%{transform:translateX(-35vw) skewX(-25deg);opacity:0}22%{opacity:.8}75%{opacity:.2}100%{transform:translateX(105vw) skewX(-25deg);opacity:0}}
.hero-grid{position:relative;z-index:5;width:min(var(--max),calc(100% - var(--gutter)*2));margin-inline:auto;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(330px,.62fr);gap:clamp(32px,5vw,78px);align-items:end;padding:clamp(150px,18vh,230px) 0 58px}.hero-copy{position:relative;isolation:isolate}.hero-ghost{position:absolute;z-index:-1;left:-.05em;top:-.5em;font-family:var(--display);font-style:italic;font-size:clamp(120px,21vw,340px);line-height:.72;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.06);white-space:nowrap;transform:translateX(-8%)}.hero-title{margin:0;font-family:var(--display);font-style:italic;text-transform:uppercase;line-height:.77;letter-spacing:-.06em;font-size:clamp(62px,9.4vw,152px);text-shadow:0 14px 46px rgba(0,0,0,.65)}.hero-title .line{display:block}.hero-title .huge{font-size:1.2em;color:var(--green);display:inline-block;transform:skewX(-5deg)}.hero-sub{max-width:680px;margin:28px 0 0;color:#d5ddd6;font-size:clamp(18px,1.55vw,23px);line-height:1.54}.hero-facts{display:flex;gap:30px;flex-wrap:wrap;margin-top:34px;padding-top:24px;border-top:1px solid var(--line)}.hero-facts div{display:grid;gap:2px}.hero-facts strong{font-family:var(--race);font-style:italic;text-transform:uppercase;color:var(--green);font-size:18px}.hero-facts span{font-size:13px;color:var(--muted)}
.glass-panel{background:linear-gradient(180deg,rgba(17,23,18,.95),rgba(7,10,8,.96));border:1px solid var(--line2);box-shadow:var(--shadow);backdrop-filter:blur(18px);position:relative;overflow:hidden}.glass-panel:before{content:"";position:absolute;inset:0 0 auto;height:3px;background:linear-gradient(90deg,var(--green),transparent)}.booking{padding:30px}.panel-title{margin:0 0 16px;font-family:var(--race);font-style:italic;text-transform:uppercase;font-size:22px}.price{display:flex;align-items:end;gap:10px;padding:18px 0;border-block:1px solid var(--line)}.price strong{font-family:var(--display);font-style:italic;font-size:clamp(64px,6vw,94px);line-height:.72;color:var(--green)}.price small{align-self:start;margin-top:8px;font-family:var(--race);font-size:10px;text-transform:uppercase;color:var(--muted)}.price span{font-family:var(--race);font-size:11px;text-transform:uppercase;margin-bottom:5px}.panel-list{display:grid;gap:13px;margin:22px 0}.panel-list div{padding-left:18px;position:relative;color:var(--muted);font-size:14px;line-height:1.35}.panel-list div:before{content:"";position:absolute;left:0;top:.45em;width:7px;height:7px;border:2px solid var(--green);transform:rotate(45deg)}.panel-list strong{display:block;color:#fff;font-family:var(--race);font-style:italic;text-transform:uppercase;font-size:12px}.panel-actions{display:grid;gap:10px}
.telemetry-wrap{position:relative;z-index:20;margin-top:-1px}.telemetry{display:grid;grid-template-columns:repeat(4,1fr);background:rgba(10,14,11,.96);border:1px solid var(--line);box-shadow:0 22px 60px rgba(0,0,0,.3)}.telemetry-item{padding:26px;border-right:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:15px;align-items:center}.telemetry-item:last-child{border-right:0}.telemetry-icon{width:48px;height:48px;border:1px solid rgba(82,255,24,.35);display:grid;place-items:center;color:var(--green);transform:skewX(-7deg)}.telemetry-icon svg{width:25px;height:25px}.telemetry strong{display:block;font-family:var(--race);font-style:italic;text-transform:uppercase;color:var(--green);font-size:15px}.telemetry span{display:block;color:var(--muted);font-size:12px;margin-top:3px}
.asym-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(28px,5vw,80px);align-items:center}.poster-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px}.poster-card{position:relative;overflow:hidden;border:1px solid var(--line);background:var(--surface);min-height:470px;isolation:isolate;clip-path:polygon(7% 0,100% 0,93% 100%,0 100%);transition:transform .4s var(--ease),border-color .3s}.poster-card:hover{transform:translateY(-12px);border-color:rgba(82,255,24,.55)}.poster-card:nth-child(1){grid-column:span 4}.poster-card:nth-child(2){grid-column:span 4;transform:translateY(-28px)}.poster-card:nth-child(2):hover{transform:translateY(-40px)}.poster-card:nth-child(3){grid-column:span 4}.poster-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;filter:grayscale(.2) contrast(1.16) brightness(.48);transition:.65s var(--ease)}.poster-card:hover img{transform:scale(1.06);filter:grayscale(0) contrast(1.14) brightness(.56)}.poster-card:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(0deg,rgba(3,5,4,.99) 5%,rgba(3,5,4,.78) 50%,transparent 100%)}.poster-content{position:absolute;inset:auto 0 0;padding:32px}.poster-number{position:absolute;top:15px;right:24px;font-family:var(--display);font-size:88px;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.2);font-style:italic}.poster-card h3{font-family:var(--display);font-style:italic;text-transform:uppercase;font-size:clamp(38px,4vw,62px);line-height:.79;letter-spacing:-.05em;margin:0;max-width:8ch}.poster-card p{color:var(--muted);line-height:1.48;font-size:15px;margin:16px 0}.card-price{display:flex;gap:10px;align-items:end;margin:18px 0}.card-price strong{font-family:var(--display);font-size:52px;font-style:italic;color:var(--green);line-height:.7}.card-price small,.card-price span{font-family:var(--race);font-size:10px;text-transform:uppercase;color:var(--muted)}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);background:var(--surface)}.stat{padding:28px;border-right:1px solid var(--line)}.stat:last-child{border-right:0}.stat strong{font-family:var(--display);font-style:italic;font-size:clamp(48px,5vw,78px);line-height:.8;color:var(--green)}.stat span{display:block;font-family:var(--race);font-style:italic;text-transform:uppercase;font-size:12px;color:var(--muted);margin-top:8px}
.editorial-band{position:relative;overflow:hidden;background:var(--green);color:#041301;padding:20px 0}.ticker{display:flex;width:max-content;animation:ticker 26s linear infinite}.ticker span{font-family:var(--display);font-style:italic;text-transform:uppercase;font-size:clamp(34px,4vw,70px);line-height:.75;padding:0 24px;white-space:nowrap}.ticker b{color:transparent;-webkit-text-stroke:1px #041301}@keyframes ticker{to{transform:translateX(-50%)}}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.step{background:var(--bg2);padding:34px;min-height:255px;position:relative;overflow:hidden}.step:before{content:attr(data-step);position:absolute;right:12px;bottom:-26px;font-family:var(--display);font-style:italic;font-size:150px;color:rgba(255,255,255,.035)}.step-icon{width:54px;height:54px;border:1px solid rgba(82,255,24,.38);display:grid;place-items:center;color:var(--green);margin-bottom:24px;transform:skewX(-8deg)}.step-icon svg{width:27px;height:27px}.step h3{font-family:var(--race);font-style:italic;text-transform:uppercase;font-size:18px;margin:0}.step p{color:var(--muted);line-height:1.5;font-size:14px;margin:10px 0 0}
.gallery-strip{display:grid;grid-template-columns:1.1fr .8fr 1fr .8fr 1.1fr;gap:10px;align-items:center}.gallery-item{position:relative;height:380px;overflow:hidden;clip-path:polygon(8% 0,100% 0,92% 100%,0 100%);border:1px solid var(--line)}.gallery-item:nth-child(even){height:320px}.gallery-item img{width:100%;height:100%;object-fit:cover;filter:grayscale(.35) contrast(1.15) brightness(.62);transition:.55s