background:var(--green)}
.rules-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.rule-card{padding:30px;background:var(--surface);border:1px solid var(--line);min-height:250px;position:relative;overflow:hidden}.rule-card:after{content:attr(data-num);position:absolute;right:14px;bottom:-30px;font-family:var(--display);font-style:italic;font-size:140px;color:rgba(255,255,255,.025)}.rule-card h3{font-family:var(--race);font-style:italic;text-transform:uppercase;font-size:18px;margin:0}.rule-card p{color:var(--muted);line-height:1.5}.rule-card strong{color:var(--green)}
.event-mosaic{display:grid;grid-template-columns:1.1fr .8fr .8fr;grid-template-rows:300px 300px;gap:12px}.event-mosaic figure{margin:0;position:relative;overflow:hidden;border:1px solid var(--line)}.event-mosaic figure:first-child{grid-row:1/3}.event-mosaic figure:nth-child(4){grid-column:2/4}.event-mosaic img{width:100%;height:100%;object-fit:cover;filter:grayscale(.25) contrast(1.15) brightness(.66);transition:.6s var(--ease)}.event-mosaic figure:hover img{transform:scale(1.05);filter:grayscale(0) contrast(1.12) brightness(.78)}
.faq-layout{display:grid;grid-template-columns:320px 1fr;gap:40px;align-items:start}.faq-sidebar{position:sticky;top:110px;display:grid;gap:8px}.faq-filter{border:1px solid var(--line);background:var(--surface);padding:15px 18px;color:#fff;font-family:var(--race);font-style:italic;text-transform:uppercase;text-align:left;cursor:pointer}.faq-filter.active{background:var(--green);color:#041301}.faq-list{border-top:1px solid var(--line)}.faq-item{border-bottom:1px solid var(--line)}.faq-q{width:100%;border:0;background:transparent;color:#fff;padding:25px 5px;display:grid;grid-template-columns:1fr 34px;gap:20px;text-align:left;cursor:pointer}.faq-q span{font-family:var(--race);font-style:italic;text-transform:uppercase;font-size:19px}.faq-q b{width:30px;height:30px;border:1px solid var(--line2);display:grid;place-items:center;color:var(--green);transition:.25s}.faq-item.open .faq-q b{transform:rotate(45deg);background:var(--green);color:#041301}.faq-a{display:grid;grid-template-rows:0fr;transition:grid-template-rows .35s var(--ease)}.faq-a>div{overflow:hidden}.faq-a p{color:var(--muted);line-height:1.65;padding:0 60px 25px 5px;margin:0}.faq-item.open .faq-a{grid-template-rows:1fr}
.form-panel{padding:34px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-family:var(--race);font-style:italic;text-transform:uppercase;font-size:11px;color:var(--muted)}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);background:#070b08;color:#fff;padding:15px;outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--green)}.field textarea{min-height:115px;resize:vertical}
.footer{position:relative;border-top:1px solid var(--line);padding:64px 0 28px;background:#020302}.footer-grid{display:grid;grid-template-columns:1.2fr .7fr .7fr;gap:50px}.footer-brand{width:250px}.footer p{color:var(--muted);line-height:1.55}.footer h4{font-family:var(--race);font-style:italic;text-transform:uppercase;font-size:14px;color:var(--green);margin:0 0 18px}.footer-links{display:grid;gap:10px}.footer-links a{color:#d7ddd8}.footer-links a:hover{color:var(--green)}.copyright{margin-top:46px;padding-top:22px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;color:var(--dim);font-size:12px}
.whatsapp-float{position:fixed;right:20px;bottom:20px;z-index:250;width:58px;height:58px;border-radius:50%;display:grid;place-items:center;background:#20d466;color:#fff;box-shadow:0 18px 45px rgba(32,212,102,.35);transition:.25s}.whatsapp-float:hover{transform:translateY(-5px) scale(1.04)}.whatsapp-float svg{width:28px;height:28px}.mobile-sticky{display:none;position:fixed;left:10px;right:10px;bottom:10px;z-index:240;gap:8px}.mobile-sticky .btn{flex:1;min-height:50px;padding-inline:10px}.reveal{opacity:0;transform:translateY(30px);transition:opacity .8s var(--ease),transform .8s var(--ease)}.reveal.in{opacity:1;transform:none}.parallax{will-change:transform}
.modal{position:fixed;inset:0;z-index:600;background:rgba(0,0,0,.78);backdrop-filter:blur(12px);display:grid;place-items:center;padding:20px;opacity:0;visibility:hidden;transition:.3s}.modal.open{opacity:1;visibility:visible}.modal-dialog{width:min(740px,100%);max-height:90vh;overflow:auto;background:var(--surface);border:1px solid var(--line2);box-shadow:var(--shadow);padding:34px;position:relative}.modal-close{position:absolute;right:16px;top:16px;width:40px;height:40px;border:1px solid var(--line);background:#070b08;cursor:pointer;color:#fff}.modal h2{font-family:var(--display);font-style:italic;text-transform:uppercase;font-size:58px;line-height:.8;margin:10px 0 14px}.modal p{color:var(--muted)}
@media(max-width:1100px){.nav,.header>.container>.header-inner>.header-cta{display:none}.menu-toggle{display:block}.header-inner{grid-template-columns:auto 1fr auto}.hero-grid,.page-hero-grid{grid-template-columns:1fr}.hero.compact{min-height:95svh}.booking{max-width:620px}.telemetry{grid-template-columns:1fr 1fr}.telemetry-item:nth-child(2){border-right:0}.telemetry-item:nth-child(-n+2){border-bottom:1px solid var(--line)}.poster-card:nth-child(n){grid-column:span 6;transform:none}.poster-card:nth-child(3){grid-column:3/11}.steps{grid-template-columns:1fr 1fr}.gallery-strip{grid-template-columns:repeat(3,1fr)}.gallery-item:nth-child(n){height:340px}.gallery-item:nth-child(4),.gallery-item:nth-child(5){display:none}.champ-card{grid-column:span 12}.champ-card:nth-child(n){transform:none}.rules-grid{grid-template-columns:1fr 1fr}.faq-layout{grid-template-columns:1fr}.faq-sidebar{position:static;grid-template-columns:repeat(3,1fr)}.big-cta{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}}
@media(max-width:760px){body{font-size:16px}.brand{width:190px}.header-inner{min-height:74px}.hero-grid,.page-hero-grid{padding-top:135px}.hero-title{font-size:clamp(58px,18vw,94px)}.page-title{font-size:clamp(70px,20vw,112px)}.hero-sub,.page-lead{font-size:17px}.hero-side-number{text-align:left}.telemetry{grid-template-columns:1fr}.telemetry-item{border-right:0;border-bottom:1px solid var(--line)}.telemetry-item:last-child{border-bottom:0}.poster-grid{display:grid;grid-template-columns:1fr}.poster-card:nth-child(n){grid-column:auto;min-height:520px}.section-title{font-size:clamp(48px,15vw,80px)}.asym-grid,.metric-board{grid-template-columns:1fr}.stats-grid{grid-template-columns:1fr 1fr}.stat:nth-child(2){border-right:0}.stat:nth-child(-n+2){border-bottom:1px solid var(--line)}.steps{grid-template-columns:1fr}.gallery-strip{grid-template-columns:1fr 1fr}.gallery-item:nth-child(n){height:290px}.gallery-item:nth-child(3){display:none}.feature-list{grid-template-columns:1fr}.spec-grid{grid-template-columns:1fr}.champ-card{grid-template-columns:1fr;padding:28px}.champ-logo{width:180px;justify-self:end}.timeline-item{grid-template-columns:1fr;gap:12px}.rules-grid{grid-template-columns:1fr}.event-mosaic{grid-template-columns:1fr 1fr;grid-template-rows:260px 260px 260px}.event-mosaic figure:first-child{grid-row:1/3}.event-mosaic figure:nth-child(4){grid-column:1/3}.faq-sidebar{grid-template-columns:1fr 1fr}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.footer-grid{grid-template-columns:1fr}.footer-grid>div:first-child{grid-column:auto}.copyright{flex-direction:column}.whatsapp-float{display:none}.mobile-sticky{display:flex}.section:last-of-type{padding-bottom:105px}.modal-dialog{padding:26px}.modal h2{font-size:48px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}.reveal{opacity:1;transform:none}}

.hero-media{background:url("../posters/home-karting.jpg") center/c