 var(--ease)}.gallery-item:hover img{transform:scale(1.07);filter:grayscale(0) contrast(1.12) brightness(.72)}.gallery-caption{position:absolute;inset:auto 0 0;padding:50px 18px 18px;background:linear-gradient(transparent,rgba(3,5,4,.96))}.gallery-caption strong{font-family:var(--race);font-style:italic;text-transform:uppercase;font-size:13px}.gallery-caption span{display:block;color:var(--muted);font-size:11px;margin-top:3px}
.feature-list{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px}.feature{display:grid;grid-template-columns:24px 1fr;gap:12px}.feature-mark{width:20px;height:20px;border:1px solid var(--green);border-radius:50%;display:grid;place-items:center;color:var(--green);font-size:11px}.feature strong{font-family:var(--race);font-style:italic;text-transform:uppercase;font-size:14px}.feature p{margin:4px 0 0;color:var(--muted);font-size:13px;line-height:1.4}
.big-cta{position:relative;overflow:hidden;border:1px solid var(--line2);background:linear-gradient(135deg,var(--surface2),var(--bg));padding:clamp(34px,5vw,72px);display:grid;grid-template-columns:1.2fr .8fr;gap:36px;align-items:center}.big-cta:before{content:"READY";position:absolute;right:-.04em;bottom:-.25em;font-family:var(--display);font-style:italic;font-size:clamp(120px,20vw,320px);color:rgba(255,255,255,.025)}.big-cta h2{margin:0;font-family:var(--display);font-style:italic;text-transform:uppercase;font-size:clamp(58px,7vw,112px);line-height:.76;letter-spacing:-.06em}.big-cta p{color:var(--muted);font-size:18px}.big-cta-actions{display:grid;gap:12px;position:relative;z-index:2}
.page-hero-grid{position:relative;z-index:5;width:min(var(--max),calc(100% - var(--gutter)*2));margin:auto;display:grid;grid-template-columns:1fr minmax(320px,.52fr);gap:50px;align-items:end;padding:clamp(155px,19vh,230px) 0 65px}.page-title{font-family:var(--display);font-style:italic;text-transform:uppercase;line-height:.76;letter-spacing:-.065em;font-size:clamp(70px,11vw,176px);margin:0}.page-title .outline{color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.7)}.page-title .green{color:var(--green)}.page-lead{max-width:720px;font-size:clamp(18px,1.5vw,23px);line-height:1.55;color:#d7ded8;margin:28px 0 0}.hero-side-number{font-family:var(--display);font-style:italic;font-size:clamp(100px,16vw,260px);line-height:.68;color:transparent;-webkit-text-stroke:1px rgba(82,255,24,.4);text-align:right}.hero-side-number small{display:block;font-family:var(--race);font-size:13px;letter-spacing:.18em;color:var(--green);-webkit-text-stroke:0;text-transform:uppercase;margin-top:20px}
.metric-board{display:grid;grid-template-columns:1.2fr .8fr;gap:18px}.metric-main,.metric-mini{background:var(--surface);border:1px solid var(--line);position:relative;overflow:hidden}.metric-main{padding:38px;min-height:360px}.metric-main h3,.metric-mini h3{font-family:var(--race);font-style:italic;text-transform:uppercase;margin:0;color:var(--muted);font-size:13px}.metric-value{font-family:var(--display);font-style:italic;font-size:clamp(86px,11vw,170px);line-height:.7;color:var(--green);margin-top:38px}.metric-value span{font-size:.25em;color:#fff;letter-spacing:0}.metric-graph{height:80px;margin-top:40px;display:flex;align-items:flex-end;gap:5px}.metric-graph i{flex:1;background:linear-gradient(var(--green),rgba(82,255,24,.08));min-height:8px;animation:bars 2.4s var(--ease) infinite alternate;transform-origin:bottom}.metric-graph i:nth-child(2n){animation-delay:-.8s}.metric-graph i:nth-child(3n){animation-delay:-1.5s}@keyframes bars{from{transform:scaleY(.35)}to{transform:scaleY(1)}}.metric-stack{display:grid;gap:18px}.metric-mini{padding:28px;min-height:171px}.metric-mini strong{display:block;font-family:var(--display);font-style:italic;color:var(--green);font-size:58px;line-height:.8;margin-top:28px}.metric-mini span{color:var(--muted);font-size:13px}
.track-stage{position:relative;min-height:580px;border:1px solid var(--line);background:radial-gradient(circle at center,rgba(82,255,24,.08),transparent 42%),#080c09;overflow:hidden;display:grid;place-items:center}.track-stage:before{content:"CIRCUIT";position:absolute;font-family:var(--display);font-style:italic;font-size:clamp(120px,22vw,330px);color:rgba(255,255,255,.02)}.track-stage svg{width:min(82%,900px);height:auto;overflow:visible}.track-path{fill:none;stroke:#fff;stroke-width:34;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 0 20px rgba(255,255,255,.1))}.track-path.green{stroke:var(--green);stroke-width:5;stroke-dasharray:12 9;animation:trackdash 2.5s linear infinite}@keyframes trackdash{to{stroke-dashoffset:-42}}.track-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}.track-tab{border:1px solid var(--line);background:var(--surface);color:#fff;padding:12px 18px;font-family:var(--race);font-style:italic;text-transform:uppercase;cursor:pointer}.track-tab.active{background:var(--green);color:#041301;border-color:var(--green)}
.spec-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.spec{padding:32px;background:var(--surface)}.spec strong{font-family:var(--display);font-style:italic;color:var(--green);font-size:58px;line-height:.8}.spec h3{font-family:var(--race);font-style:italic;text-transform:uppercase;font-size:17px;margin:18px 0 8px}.spec p{color:var(--muted);font-size:14px;line-height:1.5;margin:0}
.champ-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px}.champ-card{grid-column:span 6;min-height:500px;position:relative;overflow:hidden;background:var(--surface);border:1px solid var(--line);padding:34px;display:grid;grid-template-columns:1fr 210px;gap:24px;align-items:end;clip-path:polygon(4% 0,100% 0,96% 100%,0 100%);transition:.35s var(--ease)}.champ-card:hover{transform:translateY(-10px);border-color:rgba(82,255,24,.55)}.champ-card:nth-child(2),.champ-card:nth-child(3){transform:translateY(28px)}.champ-card:nth-child(2):hover,.champ-card:nth-child(3):hover{transform:translateY(18px)}.champ-card:before{content:attr(data-number);position:absolute;right:10px;top:-26px;font-family:var(--display);font-style:italic;font-size:190px;color:rgba(255,255,255,.025)}.champ-card h2{font-family:var(--display);font-style:italic;text-transform:uppercase;font-size:clamp(44px,5vw,78px);line-height:.78;letter-spacing:-.05em;margin:0}.champ-card p{color:var(--muted);line-height:1.5;max-width:46ch}.champ-logo{width:100%;filter:drop-shadow(0 20px 34px rgba(0,0,0,.45))}.champ-meta{display:flex;gap:18px;flex-wrap:wrap;margin:18px 0}.champ-meta span{font-family:var(--race);font-style:italic;text-transform:uppercase;font-size:11px;color:var(--green)}
.timeline{position:relative;display:grid;gap:0;border-left:1px solid var(--line);margin-left:18px}.timeline-item{display:grid;grid-template-columns:140px 1fr;gap:30px;padding:0 0 38px 34px;position:relative}.timeline-item:before{content:"";position:absolute;left:-7px;top:4px;width:13px;height:13px;background:var(--bg);border:2px solid var(--green);transform:rotate(45deg)}.timeline-date{font-family:var(--display);font-style:italic;color:var(--green);font-size:38px;line-height:.8}.timeline-content{padding-bottom:30px;border-bottom:1px solid var(--line)}.timeline-content h3{font-family:var(--race);font-style:italic;text-transform:uppercase;margin:0;font-size:20px}.timeline-content p{color:var(--muted);margin:8px 0 0;line-height:1.5}
.table-wrap{overflow:auto;border:1px solid var(--line);background:var(--surface)}table{width:100%;border-collapse:collapse;min-width:720px}th,td{padding:18px 20px;border-bottom:1px solid var(--line);text-align:left}th{font-family:var(--race);font-style:italic;text-transform:uppercase;font-size:11px;color:var(--green);background:#0d130e}td{color:#e6ebe7}.pos{font-family:var(--display);font-style:italic;font-size:34px;color:var(--green)}.points{font-family:var(--race);font-style:italic;font-size:20px}.rank-bar{height:5px;background:rgba(255,255,255,.08);margin-top:8px}.rank-bar i{display:block;height:100%;