<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Company>KartÃ³dromo Internacional de Betim</Company>
    <Product>KartÃ³dromo</Product>
    <Version>1.0.86</Version>
    <Copyright>KartÃ³dromo Internacional de Betim</Copyright>
    <!-- As telas sÃ£o desenhadas em pixels de 96 dpi. Com SystemAware, num PC em 125% (RecepÃ§Ã£o 2, .239) sÃ³ as fontes
         cresciam e tudo se sobrepunha; DpiUnawareGdiScaled faz o Windows ampliar a tela inteira por igual (texto nÃ­tido).
         Em 100% nÃ£o muda nada. -->
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
