{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "kartodromo",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "kartodromodebetim.com.br/*",
      "zone_name": "kartodromodebetim.com.br"
    },
    {
      "pattern": "www.kartodromodebetim.com.br/*",
      "zone_name": "kartodromodebetim.com.br"
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kartodromo"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "KARTODROMO_ADMIN_DB",
      "database_name": "kartodromo-admin",
      "database_id": "daeb26fd-cef9-42b8-b51a-22e20b1607fe",
      "migrations_dir": "migrations/d1"
    }
  ]
}
