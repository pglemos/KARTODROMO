{
  "name": "kartodromo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib services src api --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pre-delivery": "playwright test tests/pre-delivery-audit.spec.ts",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "scraper": "tsx services/livetime-scraper-server.ts",
    "stream:tb50": "tsx services/tb50-streamer.ts",
    "tb50:install-autostart": "powershell -ExecutionPolicy Bypass -File scripts/install-tb50-autostart.ps1",
    "tb50:install-watchdog": "powershell -ExecutionPolicy Bypass -File scripts/install-tb50-watchdog.ps1",
    "livetime:install-cloudflare-watch": "powershell -ExecutionPolicy Bypass -File scripts/install-cloudflare-vercel-watch.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@remotion/player": "^4.0.459",
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.21.0",
    "mssql": "^12.5.5",
    "next": "^16.0.0",
    "playwright": "^1.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.0",
    "remotion": "^4.0.459"
  },
  "overrides": {
    "postcss": "^8.5.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@playwright/test": "^1.60.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^4.0.0",
    "wrangler": "^4.105.0"
  }
}
