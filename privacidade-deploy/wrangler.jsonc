    { "pattern": "kartodromodebetim.com.br/privacidade*", "zone_name": "kartodromodebetim.com.br" },
    { "pattern": "www.kartodromodebetim.com.br/privacidade*", "zone_name": "kartodromodebetim.com.br" },
    { "pattern": "kartodromodebetim.com.br/excluir-conta", "zone_name": "kartodromodebetim.com.br" },
    { "pattern": "www.kartodromodebetim.com.br/excluir-conta", "zone_name": "kartodromodebetim.com.br" }
  ]
}
