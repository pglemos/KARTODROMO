{
  // 23/10: este src agora carrega as mudanças de produção (template novo de e-mail, clientes/perfil/ranking).
  // Confira o diff com o bundle publicado antes de qualquer deploy: workers/pre-cadastro/referencia-producao/.

  // Pré-cadastro online dos clientes (QR code no kartódromo). Worker separado do site para não mexer nele.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kartodromo-cadastro",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/"] },
  "r2_buckets": [{ "binding": "PRE", "bucket_name": "kartodromo-precadastro" }],
  // IDs distintos para preview e produção; substituir o ID de produção pelo banco criado no Cloudflare antes do deploy.
  "d1_databases": [{
    "binding": "MOBILE_DB",
    "database_name": "kartodromo-mobile",
    "database_id": "922619d4-519b-4047-aaca-3b86c7b707c4",
    "migrations_dir": "migrations"
  }],
  // e-mail de confirmação de conta e de troca de senha do app (Cloudflare Email Sending, o mesmo domínio dos resultados)
  // tempo real do app: uma conexão com a cronometragem repassada por WebSocket aos celulares (src/mobile/live.ts)
  "durable_objects": { "bindings": [{ "name": "AO_VIVO", "class_name": "AoVivo" }] },
  "migrations": [{ "tag": "ao-vivo-1", "new_sqlite_classes": ["AoVivo"] }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["resultados@kartodromodebetim.com.br"] }],
  "routes": [
    { "pattern": "cadastro.kartodromodebetim.com.br", "custom_domain": true },
    // reserva online (pagamento Stone). Segredos: SYNC_KEY, STONE_API_KEY, STONE_WEBHOOK_TOKEN, RESERVAS_PREVIA
    { "pattern": "reservas.kartodromodebetim.com.br", "custom_domain": true }
  ],
  // Secrets da conta e dos resultados móveis usam `wrangler secret put` em cada ambiente; nunca adicionar valores aqui.
  // Novos nomes: MOBILE_LOOKUP_KEY, MOBILE_DATA_KEY, MOBILE_PUBLISH_TOKEN e MOBILE_ADMIN_TOKEN.
  // RESERVAS_ATIVAS=1 abre ao público; STONE_URL = https://sdx-api.pagar.me/core/v5 para testar com chave sk_test_
  "vars": {
    "RESERVAS_ATIVAS": "1",
    "STONE_URL": "https://api.pagar.me/core/v5",
    "MOBILE_EMAIL_FILA": "1"
  }
}
