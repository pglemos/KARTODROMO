{
  "expo": {
    "name": "Kartódromo de Betim",
    "slug": "kartodromo-betim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "kartodromo",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "br.com.kartodromobetim.app",
      "buildNumber": "1",
      "icon": "./assets/app-icon.png"
    },
    "android": {
      "package": "br.com.kartodromobetim.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#07110f",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07110f",
          "image": "./assets/splash.png",
          "imageWidth": 210
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita usar a localização apenas durante um treino GPS pessoal com o app aberto.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
