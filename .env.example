NEXT_PUBLIC_DEFAULT_UID=58856059-c4fd-4626-aea7-42aefc048eec

# Admin login for /admin/telao. Do not commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# REST fallback, only if a JSON endpoint is later provided by LiveTime/LapTime.
LIVETIME_ENDPOINT=
LIVETIME_TIMEOUT_MS=3000

# Recommended production path: persistent scraper process exposes this URL.
# Example local scraper: http://localhost:4010/api/livetime-snapshot
LIVETIME_SNAPSHOT_ENDPOINT=
LIVETIME_CACHE_TTL_MS=10000

# Public bridge to the on-site scraper. The same base URL also exposes
# /api/tb50-page-local and /api/viplex-programs-local.
TELAO_LAYOUT_REMOTE_ENDPOINT=
TELAO_LAYOUT_REMOTE_TIMEOUT_MS=5000
VIPLEX_PROGRAMS_REMOTE_TIMEOUT_MS=5000
VIPLEX_PROGRAMS_REMOTE_ACTION_TIMEOUT_MS=90000

# Cloudflare R2 (S3-compatible) — replaces Vercel Blob for telao/tb50 state persistence.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kartodromo-telao

# Live LapTime REST process variables used by `npm run scraper`.
LIVETIME_UID=58856059-c4fd-4626-aea7-42aefc048eec
LAPTIME_API_BASE_URL=http://192.168.20.254/laptime/api
LAPTIME_API_ORIGIN=LapTimeMirror
LAPTIME_API_AUTO_AUTH=true
# Auto-auth reads the production SQL clock; keep credentials in the runtime environment only.
LAPTIME_SQL_SERVER=192.168.20.254
LAPTIME_SQL_INSTANCE=LAPTIME
LAPTIME_SQL_DATABASE=LapTime
LAPTIME_SQL_USER=
LAPTIME_SQL_PASSWORD=
LAPTIME_SQL_TIMEOUT_MS=120000
# Optional static JWT fallback when automatic auth is unavailable.
LAPTIME_TOKEN=
LIVETIME_SNAPSHOT_ENDPOINT=http://127.0.0.1:4010/api/livetime-snapshot
LIVETIME_HEADLESS=true
LIVETIME_SCRAPER_POLL_MS=2000
LIVETIME_USE_SQL=false
SCRAPER_PORT=4010

# NovaStar Taurus TB50 / ViPlex terminal API (HTTPS auto-assinado).
VIPLEX_DEVICE_BASE_URL=https://192.168.20.253:16674
VIPLEX_DEVICE_IDENTIFIER=SRVKART
# Inject this only in the process environment; never write the device password to disk.
VIPLEX_DEVICE_PASSWORD=
VIPLEX_DEVICE_SERIAL=25212A000010665
VIPLEX_DEVICE_USERNAME=admin
VIPLEX_LIVE_PROGRAM_MODE=html
VIPLEX_HTML_TEMPLATE_PROGRAM_NAME=ok
TB50_NEXT_HOST=0.0.0.0
TB50_NEXT_PORT=3100
TB50_SCOREBOARD_URL=http://192.168.20.13:3100/podio-live-tb50
TB50_DISPLAY_MODE_ENDPOINT=http://127.0.0.1:3100/api/tb50-display-mode

# LapTime -> SRVKART mirror daemon (`npm run mirror`). Reads source via LAPTIME_SQL_* and writes to
# a local LapTimeMirror database on SRVKART\SQLEXPRESS. See lib/livetime/laptime-mirror-*.ts.
SRVKART_SQL_SERVER=
SRVKART_SQL_INSTANCE=SQLEXPRESS
SRVKART_SQL_DATABASE=LapTimeMirror
SRVKART_SQL_USER=
SRVKART_SQL_PASSWORD=
# 4020 ja e' usado por outro servico no SRVKART (KartodromoLocal/api-server); o daemon usa 4030.
MIRROR_PORT=4030
# Migracao pagina-por-pagina das leituras do LapTime pro espelho (services/livetime-scraper-server.ts).
# Valores: 'production' (default, sem mudanca) | 'mirror' (le do LapTimeMirror no SRVKART).
# Clientes nao usa esse toggle: sempre le de dbo.ClienteUnificado no espelho (unico lugar onde existe).
LAPTIME_READ_SOURCE_BOOKINGS=production
LAPTIME_READ_SOURCE_RACINGS=production
# Cadencia do job que reconstroi dbo.ClienteUnificado (LapTime + CalXPro cliente/contato) no
# espelho. Default 5min — 2 das 3 fontes sao historico estatico.
MIRROR_CLIENTE_UNIFICADO_INTERVAL_MS=300000

# === AIOX Variables (added 2026-05-07) ===
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Get your key at: https://exa.ai/
EXA_API_KEY=
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=
# Sentry (error tracking)
SENTRY_DSN=
# Railway (deployment)
RAILWAY_TOKEN=
# Vercel (deployment)
VERCEL_TOKEN=
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=5.1.15
